{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Custom renovate rules for @dschach and @x2od",
  "extends": [
    ":ignoreModulesAndTests",
    "group:react",
    "replacements:all",
    "workarounds:all",
    "docker:pinDigests",
    ":approveMajorUpdates",
    ":separateMultipleMajorReleases",
    ":widenPeerDependencies"
  ],
  "schedule": [],
  "timezone": "America/Los_Angeles",
  "configMigration": true,
  "automergeType": "pr",
  "commitMessageLowerCase": "never",
  "commitMessageAction": "update",
  "commitBodyTable": true,
  "semanticCommits": "enabled",
  "semanticCommitScope": "{{depName}}",
  "commitMessageExtra": "from {{currentVersion}} to {{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if isMajor}}{{newVersion}}{{else}}{{#if isSingleVersion}}{{newVersion}}{{else}}{{#if newValue}}{{{newVersion}}}{{else}}{{{newDigestShort}}}{{/if}}{{/if}}{{/if}}{{/if}}",
  "dependencyDashboard": true,
  "dependencyDashboardAutoclose": true,
  "configWarningReuseIssue": false,
  "separateMinorPatch": false,
  "pinDigests": false,
  "github-actions": {
    "description": "All Github updates",
    "semanticCommitType": "ci"
  },
  "npm": {
    "description": "All npm updates. Note commit extra message was set globally.",
    "rangeStrategy": "bump",
    "semanticCommitType": "build",
    "commitMessageTopic": "{{prettyDepType}} {{depName}}"
  },
  // prettier-ignore
  "major": { "autoApprove": false, "automerge": false, "dependencyDashboardApproval": true, "addLabels": ["renovate", "major"] },
  // prettier-ignore
  "patch": { "autoApprove": true, "automerge": false, "addLabels": ["renovate", "patch"] },
  // prettier-ignore
  "minor": { "autoApprove": true, "automerge": false, "addLabels": ["renovate", "minor"] },
  "pre-commit": { "enabled": true },
  "vulnerabilityAlerts": { "enabled": true },
  "lockFileMaintenance": { "enabled": false },
  "packageRules": [
    {
      "description": "all minor/patch updates",
      "matchCurrentVersion": ">= 1.0.0",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "npm dependencies (rare)",
      "semanticCommitType": "deps",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"]
    },
    {
      "description": "renovate updates require approval",
      "matchManagers": ["npm"],
      "matchPackageNames": ["renovate"],
      "dependencyDashboardApproval": true,
      "autoApprove": false
    },
    {
      "description": "Keep eslint on v9. Do not allow v10 or later.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["eslint"],
      "allowedVersions": "<10"
    },
    {
      "description": "Github: turn off everything except major updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest", "rollback", "bump", "replacement"],
      "enabled": false
    },
    {
      "description": "Github major updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "commitMessageExtra": "from v{{replace '^v?([0-9]+).*$' '$1' currentVersion}} to {{prettyNewMajor}}"
    },
    {
      "description": "All prerelease",
      "matchCurrentVersion": "<1.0.0",
      "automerge": false,
      "autoApprove": false
    },
    {
      "description": "Minor/Patch updates to automerge, to save time but allow some clutter, overriding all above rules",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "/prettier/",
        "lint-staged",
        "marked",
        "mocha",
        "husky",
        "release-please",
        "/^@x2od/"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false,
      "autoApprove": true
    }
  ]
}
